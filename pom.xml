<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
		http://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<parent>
		<groupId>org.scijava</groupId>
		<artifactId>pom-scijava</artifactId>
		<version>31.1.0</version>
		<relativePath/>
	</parent>

	<groupId>io.github.jay2owe</groupId>
	<artifactId>oc3d-core</artifactId>
	<version>0.1.0</version>

	<name>oc3d-core</name>
	<description>Shared, dependency-free engine for the 3D Objects Counter plugin family: streaming connected-component labelling, single-pass label measurement, and the plumbing duplicated across variants. Built to be shaded into each plugin under a private package name, never shipped to users as a jar.</description>
	<url>https://github.com/Jay2owe/3DObjectsCounterPlus</url>
	<inceptionYear>2026</inceptionYear>
	<organization>
		<name>UK Dementia Research Institute at Imperial College London</name>
		<url>https://ukdri.ac.uk/centres/imperial</url>
	</organization>

	<!--
	  BSD-3-Clause with no asterisk. This module links net.imagej:ij (ImageJ 1.x,
	  public domain) and nothing else. That is the whole point of it: a consumer
	  that shades this module in inherits no copyleft obligation from it, so each
	  plugin's distributed licence is decided solely by its own engine
	  dependencies. See ../PLUGIN_CORE_PATTERN.md.

	  The one GPL artifact that appears anywhere near this build is
	  sc.fiji:3D_Objects_Counter, and only inside the `oracle` profile below,
	  test-scoped and disabled by default. It is never on the compile classpath
	  and never in the produced jar.
	-->
	<licenses>
		<license>
			<name>Simplified BSD License</name>
			<distribution>repo</distribution>
		</license>
	</licenses>

	<developers>
		<developer>
			<id>Jay2owe</id>
			<name>Jamie Malcolm</name>
			<email>jamiemalcolm12@gmail.com</email>
			<url>https://github.com/Jay2owe</url>
			<organization>UK Dementia Research Institute at Imperial College London</organization>
			<organizationUrl>https://www.ukdri.ac.uk/labs/brancaccio-lab</organizationUrl>
			<properties>
				<orcid>0009-0008-3862-2776</orcid>
			</properties>
			<roles>
				<role>founder</role>
				<role>lead</role>
				<role>developer</role>
				<role>maintainer</role>
			</roles>
		</developer>
	</developers>
	<contributors>
		<contributor>
			<name>Jamie Malcolm</name>
			<url>https://github.com/Jay2owe</url>
			<roles>
				<role>founder</role>
				<role>developer</role>
				<role>maintainer</role>
			</roles>
		</contributor>
	</contributors>

	<mailingLists>
		<mailingList>
			<name>Image.sc Forum</name>
			<archive>https://forum.image.sc/tag/imagej</archive>
		</mailingList>
	</mailingLists>

	<scm>
		<connection>scm:git:https://github.com/Jay2owe/3DObjectsCounterPlus</connection>
		<developerConnection>scm:git:git@github.com:Jay2owe/3DObjectsCounterPlus</developerConnection>
		<tag>HEAD</tag>
		<url>https://github.com/Jay2owe/3DObjectsCounterPlus</url>
	</scm>
	<issueManagement>
		<system>GitHub Issues</system>
		<url>https://github.com/Jay2owe/3DObjectsCounterPlus/issues</url>
	</issueManagement>
	<ciManagement>
		<system>None</system>
	</ciManagement>

	<properties>
		<license.licenseName>bsd_3</license.licenseName>
		<license.copyrightOwners>Jamie Malcolm</license.copyrightOwners>
		<!-- No main class: this module is a library, never a plugin. -->
		<enforcer.skip>true</enforcer.skip>
	</properties>

	<repositories>
		<repository>
			<id>scijava.public</id>
			<url>https://maven.scijava.org/content/groups/public</url>
		</repository>
	</repositories>

	<dependencies>
		<!--
		  The entire dependency list. ImageJ 1.x is what Fiji *is*; no user ever
		  installs it, and it is on Maven Central. Adding anything else here
		  re-creates the prerequisite problem this module exists to remove.
		-->
		<dependency>
			<groupId>net.imagej</groupId>
			<artifactId>ij</artifactId>
			<scope>provided</scope>
		</dependency>

		<dependency>
			<groupId>junit</groupId>
			<artifactId>junit</artifactId>
			<scope>test</scope>
		</dependency>
	</dependencies>

	<build>
		<plugins>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-jar-plugin</artifactId>
				<configuration>
					<archive>
						<manifest>
							<addClasspath>false</addClasspath>
						</manifest>
						<manifestEntries>
							<Automatic-Module-Name>io.github.jay2owe.oc3d.core</Automatic-Module-Name>
						</manifestEntries>
					</archive>
				</configuration>
			</plugin>
			<!--
			  The oracle test compares this module against the shipped GPL
			  reference implementation. It is excluded from both test
			  compilation and test execution in the default build, so the
			  default build never has a GPL artifact on any classpath.
			  Run it with `mvn -Poracle test`.
			-->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-compiler-plugin</artifactId>
				<configuration>
					<testExcludes>
						<testExclude>**/oracle/**</testExclude>
					</testExcludes>
				</configuration>
			</plugin>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-surefire-plugin</artifactId>
				<configuration>
					<excludes>
						<exclude>**/oracle/**</exclude>
					</excludes>
				</configuration>
			</plugin>
		</plugins>
	</build>

	<profiles>
		<!--
		  Equivalence oracle. Puts the shipped sc.fiji:3D_Objects_Counter on the
		  TEST classpath only, so StreamingLabeller can be diffed against the
		  implementation it is replacing on a randomised corpus.

		  Deliberately opt-in: this artifact is GPLv3, and the whole purpose of
		  oc3d-core is that nothing GPL is linked. Test scope inside an inactive
		  profile is neither compiled into nor distributed with the jar.
		-->
		<profile>
			<id>oracle</id>
			<dependencies>
				<dependency>
					<groupId>sc.fiji</groupId>
					<artifactId>3D_Objects_Counter</artifactId>
					<version>2.0.1</version>
					<scope>test</scope>
				</dependency>
			</dependencies>
			<build>
				<plugins>
					<plugin>
						<groupId>org.apache.maven.plugins</groupId>
						<artifactId>maven-compiler-plugin</artifactId>
						<configuration>
							<testExcludes combine.self="override"/>
						</configuration>
					</plugin>
					<plugin>
						<groupId>org.apache.maven.plugins</groupId>
						<artifactId>maven-surefire-plugin</artifactId>
						<configuration>
							<excludes combine.self="override"/>
						</configuration>
					</plugin>
				</plugins>
			</build>
		</profile>
	</profiles>
</project>
